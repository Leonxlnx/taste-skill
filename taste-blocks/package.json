{
  "name": "taste-blocks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "validate": "shadcn registry validate && node scripts/check-policy.mjs",
    "generate": "shadcn build && node scripts/build-catalog.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run validate && npm run generate && next build",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "shadcn": "4.13.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.20"
  }
}
