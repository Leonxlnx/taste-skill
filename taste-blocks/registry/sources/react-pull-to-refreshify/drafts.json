          "modifications": [
            {
              "shippedPath": "components/react-pull-to-refreshify/PullToRefreshify.tsx",
              "change": "Added the client boundary, explicit native refresh fallback, busy and live semantics, duplicate-dispatch and completion-timer guards, drag cancellation, scroll-axis gating, viewport-based bounded resistance, and reduced-motion-safe transform transitions while retaining the upstream state machine and renderText options.",
              "reason": "Meet the documented SSR, keyboard, assistive-technology, threshold, controlled-refresh, cancellation, cleanup, and reduced-motion gates without replacing the source interaction engine."
            },
            {
              "shippedPath": "components/react-pull-to-refreshify/types.ts",
              "change": "Added optional refreshButtonLabel and renderStatus props.",
              "reason": "Keep the required explicit action label and concise live status caller-owned while preserving every existing prop."
            },
            {
              "shippedPath": "components/react-pull-to-refreshify/utils/events.ts",
              "change": "Made passive-event detection lazy and server-safe and removed its temporary listener.",
              "reason": "Allow Next server evaluation and avoid retaining a detection listener."
            },
            {
              "shippedPath": "components/react-pull-to-refreshify/utils/getScrollTop.ts",
              "change": "Guarded DOM access, accepted an unresolved parent, normalized page roots, and clamped negative overscroll.",
              "reason": "Keep server evaluation safe and make the top-boundary check reliable for page and nested scrolling."
            },
            {
              "shippedPath": "components/react-pull-to-refreshify/utils/useDrag.ts",
              "change": "Added primary-input checks, a distinct cancel path, window mouse capture, pointer/touch/blur/hidden cancellation, and complete listener cleanup.",
              "reason": "Complete drags released outside the element, never refresh after cancellation, and remove global work when hidden or unmounted."
            },
            {
              "shippedPath": "components/react-pull-to-refreshify/utils/useScrollParent.ts",
              "change": "Made scroll-parent discovery client-only and based on actual overflow, limited native-scroll interception to vertical downward pulls, added disabled handling and resize/orientation re-resolution, and cleaned listeners and observation.",
              "reason": "Preserve nested and page scrolling until the real top boundary while remaining correct across mobile viewport changes and unmounts."
            }
